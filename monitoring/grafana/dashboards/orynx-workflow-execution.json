{
  "uid": "orynx-workflow-execution",
  "title": "OrynX Workflow Execution",
  "tags": ["orynx", "workflows", "tasks"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Workflows Created",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_workflows_total) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Workflows Started",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_workflows_started_total) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Workflows Completed (COMPLETED)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_workflows_completed_total{status=\"COMPLETED\"}) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Workflows Failed (FAILED)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_workflows_completed_total{status=\"FAILED\"}) or vector(0)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Tasks Executed Rate by Status",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (status) (rate(orynx_tasks_executed_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Workflow Duration Average (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "sum by (status) (rate(orynx_workflows_duration_seconds_sum[5m])) / sum by (status) (rate(orynx_workflows_duration_seconds_count[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    }
  ]
}
