{
  "uid": "orynx-resilience-recovery",
  "title": "OrynX Resilience, Workers & Recovery",
  "tags": ["orynx", "resilience", "workers", "recovery", "step25", "step26"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Active Resilience Experiments",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "orynx_resilience_active_experiments", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "noValue": "0" } }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Resilience Cleanup Failures (Total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_resilience_cleanup_failures_total)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "noValue": "0" } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Execution Workers",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_worker_pool_active)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "noValue": "0" } }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Worker Queue Depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(orynx_worker_pool_queue_size)", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "noValue": "0" } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Resilience Experiment Outcomes by Scenario",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        {
          "expr": "sum by (scenario, outcome) (increase(orynx_resilience_experiments_total[15m]))",
          "legendFormat": "{{scenario}} ({{outcome}})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Admission Control Rejections & Non-Accepted Decisions",
      "description": "Rate of non-accepted workflow admission control decisions (rejected, deferred, error) grouped by status and reason from orynx_admission_requests_total.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum by (status, reason) (rate(orynx_admission_requests_total{status!=\"accepted\"}[5m]))",
          "legendFormat": "{{status}} ({{reason}})",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker Retries, Fencing & Pool Rejections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "rate(orynx_execution_retries_total[5m])",
          "legendFormat": "Task Retries/s",
          "refId": "A"
        },
        {
          "expr": "rate(orynx_execution_fenced_total[5m])",
          "legendFormat": "Fenced Workers/s",
          "refId": "A"
        },
        {
          "expr": "rate(orynx_worker_pool_rejected_total[5m])",
          "legendFormat": "Queue Rejections/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Worker Execution Duration P95 (s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (outcome, le) (rate(orynx_execution_duration_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}} P95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
