{
  "uid": "orynx-infrastructure",
  "title": "OrynX Infrastructure (PostgreSQL & Redis)",
  "tags": ["orynx", "postgres", "redis"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "PostgreSQL Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "pg_up", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Redis Up",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "redis_up", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Redis Connected Clients",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "redis_connected_clients", "refId": "A" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "PostgreSQL Active Connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(pg_stat_activity_count)", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "PostgreSQL Transactions Committed (tx/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (datname) (rate(pg_stat_database_xact_commit[1m]))",
          "legendFormat": "{{datname}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Redis Memory Used (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "redis_memory_used_bytes",
          "legendFormat": "used_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}
