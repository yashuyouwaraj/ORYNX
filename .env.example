# ==============================================================================
# OrynX Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment and fill in real values.
# NEVER commit '.env' or any real credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# MANDATORY: PostgreSQL Database
# ------------------------------------------------------------------------------
POSTGRES_DB=orynx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_strong_postgres_password
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_a_strong_postgres_password

# ------------------------------------------------------------------------------
# MANDATORY: JWT Authentication (HS-256 requires >= 32 ASCII characters)
# ------------------------------------------------------------------------------
JWT_SECRET=replace_with_a_secure_random_at_least_32_character_secret_key!

# ------------------------------------------------------------------------------
# MANDATORY: AI Planning Service (NVIDIA NIM API)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=replace_with_your_nvidia_api_key

# ------------------------------------------------------------------------------
# OPTIONAL: Application & Container Runtime Settings
# ------------------------------------------------------------------------------
JWT_EXPIRATION=3600000
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_WS_BASE_URL=http://localhost:8080
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
ORYNX_EXECUTION_WORKER_CORE_POOL_SIZE=4
ORYNX_EXECUTION_WORKER_MAX_POOL_SIZE=8
ORYNX_EXECUTION_WORKER_QUEUE_CAPACITY=50

# ==============================================================================
# Observability Stack (Optional - `docker compose --profile observability up -d`)
# Required only when the `observability` profile is enabled:
#   - GRAFANA_ADMIN_PASSWORD
#   - POSTGRES_MONITOR_PASSWORD
# ==============================================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_strong_grafana_admin_password
POSTGRES_MONITOR_USER=orynx_monitor
POSTGRES_MONITOR_PASSWORD=replace_with_a_strong_postgres_monitor_password
OTEL_JAVAAGENT_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=1.0
ORYNX_MONITORING_SUBNET=172.29.22.0/24
ORYNX_MONITORING_NETWORK_PREFIX=172.29.22.
PROMETHEUS_MEM_LIMIT=512m
PROMETHEUS_CPU_LIMIT=1.0
GRAFANA_MEM_LIMIT=256m
GRAFANA_CPU_LIMIT=0.5
TEMPO_MEM_LIMIT=512m
TEMPO_CPU_LIMIT=1.0
OTEL_COLLECTOR_MEM_LIMIT=384m
OTEL_COLLECTOR_CPU_LIMIT=0.5
EXPORTER_MEM_LIMIT=128m
EXPORTER_CPU_LIMIT=0.25
ALERTMANAGER_MEM_LIMIT=128m
ALERTMANAGER_CPU_LIMIT=0.25
ALERTMANAGER_WEBHOOK_URL=http://127.0.0.1:9093/-/healthy

