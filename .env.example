# ==============================================================================
# OrynX Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in your local environment and fill in actual values.
# NEVER commit the actual '.env' file or any real secrets to source control.
# ==============================================================================

# Database Configuration (PostgreSQL)
# Used by: auth-service, orchestrator-service, execution-service
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace_with_your_database_password
POSTGRES_DB=orynx
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_your_database_password

# Authentication & Security (JWT)
# Used by: auth-service
# JWT_SECRET MUST be at least 256 bits (32 ASCII characters) long for HS-256.
JWT_SECRET=replace_with_a_secure_random_at_least_32_character_secret_key!
JWT_EXPIRATION=3600000

# AI / Planning Service (NVIDIA NIM API)
# Used by: planning-service, orchestrator-service
NVIDIA_API_KEY=replace_with_your_nvidia_api_key
